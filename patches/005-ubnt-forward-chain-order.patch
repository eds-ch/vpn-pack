+// ubntFindForwardInsertPos returns the iptables position number at which
+// a rule should be inserted in the FORWARD chain on UBNT devices — immediately
+// after UBIOS_FORWARD_JUMP. On List error returns -1 (caller appends); if
+// UBIOS_FORWARD_JUMP is absent, appends at the end rather than position 1, so
+// ts-forward never shadows the UniFi zone chains (mirror of the INPUT path).
+func ubntFindForwardInsertPos(ipt iptablesInterface) int {
+	rules, err := ipt.List("filter", "FORWARD")
+	if err != nil {
+		log.Printf("[unexpected] ubnt: listing filter/FORWARD failed (%v); appending ts-forward at end", err)
+		return -1
+	}
+	for idx, rule := range rules {
+		if strings.Contains(rule, "-j UBIOS_FORWARD_JUMP") {
+			return idx + 1
+		}
+	}
+	log.Printf("[unexpected] ubnt: UBIOS_FORWARD_JUMP not found in filter/FORWARD; appending ts-forward at end to avoid fail-open")
+	// len(rules) counts the chain-policy line plus each rule, which equals
+	// (ruleCount + 1) — exactly the 1-based position that appends after the
+	// last rule via Insert.
+	return len(rules)
+}
+
+// ubntEnsureForwardHook ensures -j ts-forward is in FORWARD after
+// UBIOS_FORWARD_JUMP. Handles fresh install, upgrade (misplaced), and no-op.
+func ubntEnsureForwardHook(ipt iptablesInterface) error {
+	args := []string{"-j", "ts-forward"}
+
+	exists, err := ipt.Exists("filter", "FORWARD", args...)
+	if err != nil {
+		return fmt.Errorf("checking ts-forward in filter/FORWARD: %w", err)
+	}
+
+	if exists {
+		if !ubntIsForwardMisplaced(ipt) {
+			return nil
+		}
+		if err := ipt.Delete("filter", "FORWARD", args...); err != nil {
+			return fmt.Errorf("removing misplaced ts-forward: %w", err)
+		}
+	}
+
+	pos := ubntFindForwardInsertPos(ipt)
+	if pos < 1 {
+		// List failed; fall back to a plain append so the hook still exists.
+		if err := ipt.Append("filter", "FORWARD", args...); err != nil {
+			return fmt.Errorf("appending ts-forward in filter/FORWARD: %w", err)
+		}
+		return nil
+	}
+	if err := ipt.Insert("filter", "FORWARD", pos, args...); err != nil {
+		return fmt.Errorf("adding ts-forward in filter/FORWARD: %w", err)
+	}
+	return nil
+}
+
+// ubntIsForwardMisplaced reports whether ts-forward appears before
+// UBIOS_FORWARD_JUMP in the FORWARD chain.
+func ubntIsForwardMisplaced(ipt iptablesInterface) bool {
+	rules, err := ipt.List("filter", "FORWARD")
+	if err != nil {
+		return false
+	}
+	ubiosIdx, tsIdx := -1, -1
+	for idx, rule := range rules {
+		if strings.Contains(rule, "-j UBIOS_FORWARD_JUMP") {
+			ubiosIdx = idx
+		}
+		if strings.Contains(rule, "-j ts-forward") {
+			tsIdx = idx
+		}
+	}
+	return ubiosIdx >= 0 && tsIdx >= 0 && tsIdx < ubiosIdx
+}
+
+// ubntFindInputInsertPos returns the iptables position number at which the
+// -j ts-input hook should be inserted in the INPUT chain on UBNT devices —
+// immediately after UBIOS_INPUT_JUMP, so UniFi zone policies evaluate before
+// Tailscale's terminal ACCEPT rules. If UBIOS_INPUT_JUMP is not found we must
+// NOT fall back to position 1 (that would re-introduce the M5 fail-open where
+// ts-input shadows the zone chains); instead we append at the end and warn.
+func ubntFindInputInsertPos(ipt iptablesInterface) int {
+	rules, err := ipt.List("filter", "INPUT")
+	if err != nil {
+		log.Printf("[unexpected] ubnt: listing filter/INPUT failed (%v); appending ts-input at end", err)
+		return -1
+	}
+	for idx, rule := range rules {
+		if strings.Contains(rule, "-j UBIOS_INPUT_JUMP") {
+			return idx + 1
+		}
+	}
+	log.Printf("[unexpected] ubnt: UBIOS_INPUT_JUMP not found in filter/INPUT; appending ts-input at end to avoid fail-open")
+	// len(rules) counts the chain-policy line plus each rule, which equals
+	// (ruleCount + 1) — exactly the 1-based position that appends after the
+	// last rule via Insert.
+	return len(rules)
+}
+
+// ubntEnsureInputHook ensures -j ts-input is in INPUT after UBIOS_INPUT_JUMP.
+// Handles fresh install, upgrade (misplaced at position 1), and no-op.
+func ubntEnsureInputHook(ipt iptablesInterface) error {
+	args := []string{"-j", "ts-input"}
+
+	exists, err := ipt.Exists("filter", "INPUT", args...)
+	if err != nil {
+		return fmt.Errorf("checking ts-input in filter/INPUT: %w", err)
+	}
+
+	if exists {
+		if !ubntIsInputMisplaced(ipt) {
+			return nil
+		}
+		if err := ipt.Delete("filter", "INPUT", args...); err != nil {
+			return fmt.Errorf("removing misplaced ts-input: %w", err)
+		}
+	}
+
+	pos := ubntFindInputInsertPos(ipt)
+	if pos < 1 {
+		// List failed; fall back to a plain append so the hook still exists.
+		if err := ipt.Append("filter", "INPUT", args...); err != nil {
+			return fmt.Errorf("appending ts-input in filter/INPUT: %w", err)
+		}
+		return nil
+	}
+	if err := ipt.Insert("filter", "INPUT", pos, args...); err != nil {
+		return fmt.Errorf("adding ts-input in filter/INPUT: %w", err)
+	}
+	return nil
+}
+
+// ubntIsInputMisplaced reports whether ts-input appears before
+// UBIOS_INPUT_JUMP in the INPUT chain. The ts-input-guard hook (which shares
+// the "ts-input" prefix) is deliberately excluded via exact-token matching.
+func ubntIsInputMisplaced(ipt iptablesInterface) bool {
+	rules, err := ipt.List("filter", "INPUT")
+	if err != nil {
+		return false
+	}
+	ubiosIdx, tsIdx := -1, -1
+	for idx, rule := range rules {
+		if strings.Contains(rule, "-j UBIOS_INPUT_JUMP") {
+			ubiosIdx = idx
+		}
+		if strings.HasSuffix(rule, "-j ts-input") {
+			tsIdx = idx
+		}
+	}
+	return ubiosIdx >= 0 && tsIdx >= 0 && tsIdx < ubiosIdx
+}
